# SY1SY2 Stage B (0x1C10EE): 240 output frames of a resampled stereo test signal.
#
# Voice 0 plays a 128-frame circular ring (DM 0xC0000) at ratio 0.7312 source frames per output
# frame from position 0.3 frames with kernel 2 (fc = 1.00) and gain 1.0. One Stage B call yields one
# stereo frame, accumulated into the output frame at DM 0x932CA, so the two words are cleared before
# and captured after every call. The ring contents (hash signal, exact in f32) are captured first so
# the Rust reference renderer needs no signal generator.
# Run:  sharc-ref sy_sram.bin tools/oracle_scenarios/sy_stage_b_resample.scn --out target/oracle/resample
meta rate 48000
meta ref.mode resample
meta ref.kernel 2
meta ref.gain 1.0
meta ref.ratio 0.7312
meta ref.pos_frames 0.3
meta ref.ring 128
warmup 0x1c0b2d 100000 flag12=1
fill 0xC0000 128 hash stride=2 mul=37 add=11
fill 0xC0001 128 hash stride=2 mul=23 add=5
capture srcL 0xC0000 128 stride=2
capture srcR 0xC0001 128 stride=2
voice 0 stage_b=on kernel=2 gain=1.0 ratio=0.7312 pos_frames=0.3
loop 240
poke 0x932ca 0
poke 0x932cb 0
run 0x1c0758 100000
capture L 0x932ca 1
capture R 0x932cb 1
end
