# SY1SY2: a sample voice started through the real command sequence and the real audio ISR.
#
# Sequence (docs/research/sy-smp-audio.md section 3): FIFO reset interrupt (vector 13), message
# `rec+0x14 <- 0x1C07CD` (Stage A "prepare"), audio ISR (vector 17), message `rec+0x14 <- 0x1C084C`
# ("go": Stage A installs the resampler 0x1C10EE into Stage B), then one audio ISR per output frame.
# The firmware slews gain and step itself (ISR step 3 and 4); the harness
#   * fills the 128-frame ring (the external-port refill DMA and the unpacker are not modelled),
#   * writes the pitch table entry the ARM would send (DM 0x93580, 16-bit packed float),
#   * keeps the refill bookkeeping word rec+0x10 above the refill threshold (see the document).
# Run:  sharc-ref sy.bin tools/oracle_scenarios/sy_voice_sine.scn --out target/oracle/sy_voice --wav
#       sinc_ref target/oracle/sy_voice.csv   (reads srcL/srcR, gainL/gainR and step from the dump)
meta rate 48000
meta ref.mode resample
meta ref.kernel 0
meta ref.gain 1.0
meta ref.ratio 0.625
meta ref.pos_frames -2.5
meta ref.ring 128
warmup 0x1c0b2d 100000 flag12=1
irq 13
msg 0x92414 0x1c07cd
irq 17
fill 0xC0000 128 sine stride=2 freq=0.0625 amp=0.5
fill 0xC0001 128 sine stride=2 freq=0.0625 amp=0.5
poke 0x93580 0x0800
irq 13
msg 0x92414 0x1c084c
loop 240
poke 0x92410 0x200
irq 17
capture L 0x932ca 1
capture R 0x932cb 1
capture gainL 0x92408 1
capture gainR 0x92409 1
capture step 0x9242d 1
end
capture srcL 0xC0000 128 stride=2
capture srcR 0xC0001 128 stride=2
